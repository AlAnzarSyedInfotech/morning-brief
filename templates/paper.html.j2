<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}: {{ date_text }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Inter:wght@400;500;600&display=swap">
<style>
:root {
  --paper: #FBFAF7; --ink: #16181D; --muted: #4A4F58; --body: #3B3F47;
  --rule: #D9D6CE; --tint: #EFEDE6; --accent: #1F4E8C; --amber: #7A4F00;
  --serif: "Source Serif 4", Georgia, serif;
  --sans: Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans); }
a { color: var(--ink); text-decoration: none; }
a:hover { color: var(--accent); text-decoration: underline; }
a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.wrap { max-width: 1280px; margin: 0 auto; padding: 32px 24px 56px; display: flex; flex-direction: column; gap: 32px; }
.dateline { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; font-size: 13px; color: var(--muted); }
.bar { height: 3px; background: var(--accent); margin: 16px 0; }
h1.mast { margin: 0; text-align: center; font-family: var(--serif); font-weight: 700; font-size: clamp(40px, 7vw, 64px); line-height: 1.05; }
.tagline { margin: 12px 0 16px; text-align: center; font-size: 15px; color: var(--muted); }
.navrow { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; padding: 12px 0; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
.navrow nav { display: flex; flex-wrap: wrap; gap: 20px; font-size: 14px; font-weight: 600; }
.legend { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 12px; color: var(--muted); }
.g { display: inline-block; padding: 1px 7px; border-radius: 4px; font-weight: 600; font-size: 12px; line-height: 18px; }
.gA { background: var(--ink); color: #fff; border: 1px solid var(--ink); }
.gB { border: 1px solid var(--ink); color: var(--ink); }
.gC { border: 1px dashed var(--amber); color: var(--amber); }
.tag { border: 1px solid #8C887E; padding: 0 6px; border-radius: 4px; font-size: 12px; }
.columns { display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-start; }
main { flex: 999 1 640px; min-width: 0; display: flex; flex-direction: column; gap: 40px; }
.sidecol { flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
aside { display: flex; flex-direction: column; gap: 20px; padding: 24px; background: var(--tint); border-radius: 8px; }
.mk h3 { margin: 0 0 6px; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); }
.mk table { width: 100%; border-collapse: collapse; font-size: 14px; font-variant-numeric: tabular-nums; }
.mk th { text-align: left; font-weight: 600; font-size: 12px; color: var(--muted); padding: 4px 0; border-bottom: 1px solid #CFCBC0; }
.mk td { padding: 5px 0; border-bottom: 1px solid #E2DED4; }
.mk th.r, .mk td.r { text-align: right; padding-left: 12px; white-space: nowrap; }
.mk .src { margin: 6px 0 0; font-size: 12px; color: var(--muted); }
.mk .src a { color: var(--muted); text-decoration: underline; }
.mk .big { font-size: 17px; font-weight: 600; font-family: var(--serif); }
.up { color: #1B6E3A; }
.down { color: #A1251B; }
.mk-sub { display: flex; flex-direction: column; gap: 4px; }
.kicker { font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; color: var(--accent); }
.lead { display: flex; flex-direction: column; gap: 12px; padding-bottom: 32px; border-bottom: 1px solid var(--rule); }
.lead h2 { margin: 0; font-family: var(--serif); font-size: clamp(28px, 4vw, 40px); line-height: 1.15; font-weight: 700; }
.lead p { margin: 0; font-size: 17px; line-height: 1.55; color: var(--body); max-width: 72ch; }
.meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); }
section > h2 { margin: 0; font-family: var(--serif); font-size: 28px; padding-bottom: 8px; border-bottom: 2px solid var(--ink); }
section { display: flex; flex-direction: column; gap: 20px; }
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px 32px; }
.story { display: flex; flex-direction: column; gap: 8px; padding-top: 16px; border-top: 1px solid var(--rule); }
.story h3 { margin: 0; font-family: var(--serif); font-size: 21px; line-height: 1.25; font-weight: 600; }
.story p { margin: 0; font-size: 15px; line-height: 1.5; color: var(--body); }
aside .story { border-top-color: #CFCBC0; }
aside .story h3 { font-size: 18px; }
aside > h2 { margin: 0; font-family: var(--serif); font-size: 26px; }
.desk { display: flex; flex-direction: column; gap: 14px; padding: 20px; border: 2px solid var(--ink); border-radius: 8px; background: #fff; }
.desk h3 { margin: 0; font-size: 18px; }
.desk-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: baseline; }
.desk-row a { font-family: var(--serif); font-size: 19px; font-weight: 600; flex: 1 1 320px; }
.empty { margin: 0; font-size: 14px; color: var(--muted); }
footer { display: flex; flex-direction: column; gap: 8px; padding-top: 16px; border-top: 2px solid var(--ink); font-size: 13px; color: var(--muted); }
footer .stats { display: flex; flex-wrap: wrap; gap: 8px 24px; }
footer p { margin: 0; }
</style>
</head>
<body>
{% macro grade(g) -%}
<span class="g g{{ g }}" title="{{ {'A': 'Official or primary source', 'B': 'Reputable secondary source', 'C': 'Unconfirmed discovery source'}[g] }}">{{ g }}</span>
{%- endmacro %}
{% macro meta(s) -%}
<div class="meta">
  {{ grade(s.grade) }}
  <span>{{ s.source }}</span><span>{{ s.age }}</span>
  {% if s.tag %}<span class="tag">{{ s.tag }}</span>{% endif %}
  {% if s.also %}<span>Also covered by {{ s.also|join(", ") }}</span>{% endif %}
</div>
{%- endmacro %}
{% macro story(s, summary=true) -%}
<article class="story">
  <div class="kicker">{{ s.kicker }}</div>
  <h3><a href="{{ s.link }}" target="_blank" rel="noopener">{{ s.title }}</a></h3>
  {% if summary and s.summary %}<p>{{ s.summary }}</p>{% endif %}
  {{ meta(s) }}
</article>
{%- endmacro %}
{% macro empty_note() -%}
<p class="empty">No new stories from these sources in the last {{ window_hours }} hours.</p>
{%- endmacro %}

<div class="wrap">
<header>
  <div class="dateline">
    <span>{{ date_text }}</span>
    <span>{{ city }} edition, built {{ time_text }} PKT</span>
    <span>Covering the last {{ window_hours }} hours</span>
  </div>
  <div class="bar"></div>
  <h1 class="mast">{{ title }}</h1>
  <p class="tagline">Microsoft Data &amp; AI, industry and clients, and the global AI agenda</p>
  <div class="navrow">
    <nav aria-label="Sections">
      <a href="#microsoft">Microsoft Watch</a>
      <a href="#industry">Industry &amp; Clients</a>
      <a href="#global">Global AI Agenda</a>
      <a href="#side">Off the Clock</a>
      <a href="#markets">Markets</a>
    </nav>
    <div class="legend">
      <span>Source grade:</span>
      <span class="g gA">A Official</span>
      <span class="g gB">B Reputable</span>
      <span class="g gC">C Unconfirmed</span>
    </div>
  </div>
</header>

<div class="columns">
<main>
  {% if lead %}
  <article class="lead">
    <div class="kicker">Lead story: {{ lead.kicker }}</div>
    <h2><a href="{{ lead.link }}" target="_blank" rel="noopener">{{ lead.title }}</a></h2>
    {% if lead.summary %}<p>{{ lead.summary }}</p>{% endif %}
    {{ meta(lead) }}
  </article>
  {% endif %}

  <section id="microsoft">
    <h2>Microsoft Watch</h2>
    <div class="desk">
      <div class="desk-row" style="justify-content: space-between">
        <h3>Pricing &amp; Licensing Desk</h3>
        <span class="meta">Shown as fact only when Microsoft confirms it</span>
      </div>
      {% for s in pricing_confirmed %}
      <div class="desk-row"><span class="g gA">Confirmed by Microsoft</span><a href="{{ s.link }}" target="_blank" rel="noopener">{{ s.title }}</a></div>
      {% endfor %}
      {% for s in pricing_reported %}
      <div class="desk-row"><span class="g gC">Reported, not confirmed</span><a href="{{ s.link }}" target="_blank" rel="noopener">{{ s.title }}</a></div>
      {% endfor %}
      {% if not pricing_confirmed and not pricing_reported %}
      <p class="empty">No pricing or licensing changes found today.</p>
      {% endif %}
    </div>
    <div class="desk">
      <div class="desk-row" style="justify-content: space-between">
        <h3>Events &amp; Certification Desk</h3>
        <span class="meta">Microsoft, fintech and AI events, and exam voucher offers (last 7 days)</span>
      </div>
      {% for c in coming_up %}
      <div class="desk-row"><span class="g gA">Coming up</span>{% if c.link %}<a href="{{ c.link }}" target="_blank" rel="noopener">{{ c.name }}</a>{% else %}<span style="font-family:var(--serif);font-size:19px;font-weight:600;flex:1 1 320px">{{ c.name }}</span>{% endif %}<span class="meta">{{ c.dates }}, {{ c.when }}{% if c.note %}. {{ c.note }}{% endif %}</span></div>
      {% endfor %}
      {% for s in offers %}
      <div class="desk-row"><span class="g gA">Voucher offer</span><a href="{{ s.link }}" target="_blank" rel="noopener">{{ s.title }}</a></div>
      {% endfor %}
      {% for s in events %}
      <div class="desk-row"><span class="g gB">{{ s.label }}</span><a href="{{ s.link }}" target="_blank" rel="noopener">{{ s.title }}</a><span class="meta">{{ s.source }}, {{ s.age }}</span></div>
      {% endfor %}
      {% for n in page_news %}
      <div class="desk-row"><span class="g gB">New on {{ n.page }}</span><a href="{{ n.link }}" target="_blank" rel="noopener">{{ n.text }}</a></div>
      {% endfor %}
      {% if not coming_up and not offers and not events and not page_news %}
      <p class="empty">No upcoming events or voucher offers found this week.</p>
      {% endif %}
      <p class="empty">Voucher terms vary by offer and region; check eligibility on the offer page before registering.</p>
    </div>
    {% if sections.microsoft %}
    <div class="grid">{% for s in sections.microsoft %}{{ story(s) }}{% endfor %}</div>
    {% else %}{{ empty_note() }}{% endif %}
  </section>

  <section id="industry">
    <h2>Industry &amp; Clients</h2>
    {% if sections.industry %}
    <div class="grid">{% for s in sections.industry %}{{ story(s, summary=false) }}{% endfor %}</div>
    {% else %}{{ empty_note() }}{% endif %}
  </section>

  <section id="global">
    <h2>Global AI Agenda</h2>
    {% if sections.global %}
    <div class="grid">{% for s in sections.global %}{{ story(s) }}{% endfor %}</div>
    {% else %}{{ empty_note() }}{% endif %}
  </section>
</main>

<div class="sidecol">
<aside id="side" aria-label="Off the Clock">
  <div>
    <h2>Off the Clock</h2>
    <p class="empty">Career and personal interests</p>
  </div>
  {% for s in sections.side %}{{ story(s, summary=false) }}{% endfor %}
  {% if not sections.side %}{{ empty_note() }}{% endif %}
</aside>

{% macro chg(v, suffix="%") -%}
<span class="{{ 'up' if v > 0 else ('down' if v < 0 else '') }}">{{ '+' if v > 0 else '' }}{{ '{:,.2f}'.format(v) }}{{ suffix }}</span>
{%- endmacro %}
{% macro stock_table(rows, label) -%}
<table><thead><tr><th>{{ label }}</th><th class="r">Price (Rs)</th><th class="r">Change</th></tr></thead><tbody>
{% for s in rows %}<tr><td title="{{ s.name }}">{{ s.symbol }}</td><td class="r">{{ '{:,.2f}'.format(s.price) }}</td><td class="r">{{ chg(s.change_pct) }}</td></tr>{% endfor %}
</tbody></table>
{%- endmacro %}

{% if markets.enabled %}
<aside id="markets" aria-label="Markets" class="mk">
  <div>
    <h2 style="margin:0;font-family:var(--serif);font-size:26px">Markets</h2>
    <p class="empty">Daily snapshot taken when the paper was built, not live prices. For information only, not investment advice.</p>
  </div>

  <div class="mk-sub">
    <h3>Open market rates (PKR)</h3>
    {% if markets.fx %}
    <table><thead><tr><th>Currency</th><th class="r">Buying</th><th class="r">Selling</th></tr></thead><tbody>
    {% for r in markets.fx.rows %}<tr><td>{{ r.code }}</td><td class="r">{{ '{:,.2f}'.format(r.buy) }}</td><td class="r">{{ '{:,.2f}'.format(r.sell) }}</td></tr>{% endfor %}
    </tbody></table>
    <p class="src"><span class="g gA">A</span> <a href="{{ markets.fx.link }}" target="_blank" rel="noopener">{{ markets.fx.source }}</a>, closing rates of {{ markets.fx.date }}</p>
    {% else %}<p class="empty">Not available today.</p>{% endif %}
  </div>

  <div class="mk-sub">
    <h3>Gold</h3>
    <table><tbody>
      <tr><td>24K per tola (Pakistan)</td><td class="r">{% if markets.gold_pk %}{% if markets.gold_pk.estimated %}≈ {% endif %}Rs {{ '{:,.0f}'.format(markets.gold_pk.price) }}{% else %}n/a{% endif %}</td></tr>
      <tr><td>International, per ounce</td><td class="r">{% if markets.gold_intl %}US$ {{ '{:,.2f}'.format(markets.gold_intl.price) }}{% else %}n/a{% endif %}</td></tr>
    </tbody></table>
    {% if markets.gold_pk and markets.gold_pk.estimated %}<p class="src"><span class="tag">Estimate</span> Official APGJSA rate not found today. Estimated from the international price plus a US${{ markets.gold_pk.premium }} premium, at the open market USD selling rate. Check the official rate before buying or selling.</p>{% elif markets.gold_pk %}<p class="src"><span class="g gB">B</span> Pakistan rate as reported by <a href="{{ markets.gold_pk.link }}" target="_blank" rel="noopener">{{ markets.gold_pk.source }}</a> (APGJSA rates{% if markets.gold_pk.date %}, {{ markets.gold_pk.date }}{% endif %})</p>{% else %}<p class="src">No Pakistan gold rate report found in the last 3 days.</p>{% endif %}
    {% if markets.gold_intl %}<p class="src"><span class="g gC">C</span> International price from <a href="{{ markets.gold_intl.link }}" target="_blank" rel="noopener">{{ markets.gold_intl.source }}</a></p>{% endif %}
  </div>

  <div class="mk-sub">
    <h3>PSX indices</h3>
    {% if markets.indices %}
    <table><tbody>
    {% for i in markets.indices %}<tr><td>{{ {'KSE100': 'KSE-100', 'KMI30': 'KMI-30 (Meezan)'}.get(i.name, i.name) }}</td><td class="r big">{{ '{:,.2f}'.format(i.value) }}</td><td class="r">{{ chg(i.change_pct) }}</td></tr>{% endfor %}
    </tbody></table>
    {% else %}<p class="empty">Not available today.</p>{% endif %}
  </div>

  {% if markets.kse_top %}
  <div class="mk-sub">
    <h3>KSE-100: largest 10 companies</h3>
    {{ stock_table(markets.kse_top, "Symbol") }}
  </div>
  {% endif %}
  {% if markets.kse_gainers or markets.kse_losers %}
  <div class="mk-sub">
    <h3>KSE-100: top gainers</h3>
    {{ stock_table(markets.kse_gainers, "Symbol") }}
  </div>
  <div class="mk-sub">
    <h3>KSE-100: top losers</h3>
    {{ stock_table(markets.kse_losers, "Symbol") }}
  </div>
  {% endif %}
  {% if markets.kmi_gainers or markets.kmi_losers %}
  <div class="mk-sub">
    <h3>KMI-30: top gainers</h3>
    {{ stock_table(markets.kmi_gainers, "Symbol") }}
  </div>
  <div class="mk-sub">
    <h3>KMI-30: top losers</h3>
    {{ stock_table(markets.kmi_losers, "Symbol") }}
  </div>
  {% endif %}
  <p class="src"><span class="g gA">A</span> Stock and index data from the <a href="https://dps.psx.com.pk/" target="_blank" rel="noopener">PSX Data Portal</a>, last trading session.</p>
</aside>
{% endif %}
</div>
</div>

<footer>
  <div class="stats">
    <span>Sources checked: {{ stats.checked }}</span>
    <span>Sources reached: {{ stats.ok }}</span>
    <span>Stories: {{ story_count }}</span>
    <span>Duplicates merged: {{ merged }}</span>
  </div>
  {% if stats.failed %}<p>Could not reach today: {{ stats.failed|join(", ") }}.</p>{% endif %}
  <p>Every headline links to the original article. Summaries are taken from each source's own feed; check the original before quoting it to a client.</p>
</footer>
</div>
</body>
</html>
